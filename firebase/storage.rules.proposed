// PROPOSED - not deployed, not emulator-tested.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function validImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Legacy uploads (old clients wrote here): keep readable, no new writes.
    match /images/{file} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Idempotent per message id; only the owner may write.
    match /chat_images/{uid}/{file} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && validImage();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /avatars/{uid}/{file} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && validImage();
      allow delete: if signedIn() && request.auth.uid == uid;
    }
  }
}
