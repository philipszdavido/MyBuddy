// PROPOSED rules — NOT deployed, NOT yet tested against the emulator.
// Review, run `firebase emulators:start` + rules unit tests, then rename to firestore.rules.
// Known gap: `user_feed` likes/dislikes cannot be made abuse-proof from the client
// (a user can still like repeatedly). Move fan-out + reactions to a Cloud Function and
// then set `user_feed` to `allow write: if false`.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myPhone() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber;
    }

    // Users: any signed-in user may read (needed for contact matching by phone);
    // only the owner may write their own document.
    // TODO(privacy): move `email` to users/{uid}/private/account so it is not queryable.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false; // deletion handled server-side
    }

    // Push tokens: owner only. (The Cloud Function reads them with admin privileges.)
    match /users/{uid}/devices/{deviceId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Blocks: owner only. Presence of users/{recipient}/blocks/{sender} stops sender messaging recipient (see messages rule).
    match /users/{uid}/blocks/{blockedId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Reports are write-only for clients; moderators read them with admin tooling.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason in ['spam', 'harassment', 'inappropriate', 'impersonation', 'other'];
      allow read, update, delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      // participants may be re-sent in either order; membership must not change
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants.toSet() == resource.data.participants.toSet();
      allow delete: if false;

      match /messages/{messageId} {
        // getAfter(): the chat document may be created in the same batch as its first message
        function isParticipantAfter() {
          return request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn() && isParticipantAfter()
          && request.resource.data.senderId == request.auth.uid
          && !exists(/databases/$(database)/documents/users/$(request.resource.data.recipientId)/blocks/$(request.auth.uid));
        // recipient may only flip `seen`
        allow update: if signedIn() && isParticipantAfter()
          && resource.data.recipientId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
        // The sender's idempotent retry re-writes the same message id (new server timestamp, seen reset).
        // Without this rule a retry after a lost response would be rejected as "permission denied".
        allow update: if signedIn() && isParticipantAfter()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timestamp', 'seen']);
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // Feed copies. Any signed-in user may write a copy into a contact's feed only as themselves
    // (feedOwnerId must be their own phone). Re-publishing the same post id is an update by the same author.
    // Known gap: the client cannot be stopped from spamming non-contacts; move fan-out to a Cloud Function
    // and then set this to `allow write: if false`.
    match /user_feed/{ownerPhone}/posts/{postId} {
      allow read: if signedIn() && string(myPhone()) == ownerPhone;
      allow create: if signedIn() && request.resource.data.feedOwnerId == string(myPhone());
      allow update: if signedIn() && resource.data.feedOwnerId == string(myPhone())
        && request.resource.data.feedOwnerId == string(myPhone());
      allow delete: if false;
    }

    // One reaction per (post, user). Counts are server-side aggregation queries.
    match /post_reactions/{postId}/users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.type in ['like', 'dislike'];
      allow delete: if signedIn() && request.auth.uid == uid;
    }
  }
}
