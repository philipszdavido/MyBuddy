{
  "name": "mybuddy-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MyBuddy API and background workers (NestJS modular monolith)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:int": "jest --config test/jest-int.json --runInBand",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node dist/scripts/seed.js",
    "openapi": "node dist/scripts/openapi.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1168.0",
    "@aws-sdk/s3-request-presigner": "3.1168.0",
    "@bull-board/api": "6.21.3",
    "@bull-board/express": "6.21.3",
    "@bull-board/nestjs": "6.21.3",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.10",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/platform-socket.io": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.2.10",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "firebase-admin": "13.10.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "nodemailer": "6.10.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.10",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
