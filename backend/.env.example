# ─── MyBuddy backend configuration ─────────────────────────────────────────────
# Copy to .env for local development. Never commit real values. In staging/production, inject these
# from your secret manager; the process refuses to start if a required value is missing.

NODE_ENV=development          # development | test | staging | production
PORT=3000
LOG_LEVEL=info                # trace | debug | info | warn | error

# PostgreSQL (Prisma). docker-compose exposes the dev database on 5433.
DATABASE_URL=postgresql://mybuddy:mybuddy@localhost:5433/mybuddy?schema=public

# Redis: cache, rate limits, presence, Socket.IO adapter, BullMQ. Use a non-evicting instance (noeviction).
REDIS_URL=redis://localhost:6380

# Firebase Admin (service account): verifies ID tokens, deletes accounts, sends FCM push.
# FIREBASE_PRIVATE_KEY keeps its newlines as literal \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Development only: verify tokens from the Firebase Auth emulator instead (forbidden in staging/production).
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Cloudflare R2 (S3 API). Create an API token with Object Read & Write on the bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public custom domain bound to the bucket, serving only processed variants under u/… (no trailing slash).
R2_PUBLIC_URL=
# Override the S3 endpoint (local S3 mock: http://localhost:9090). Leave empty for R2.
# R2_ENDPOINT=

# Comma-separated browser origins allowed by CORS (the iOS app does not need CORS).
# CORS_ORIGINS=https://admin.mybuddy.app

# Feed: authors with more followers than this are merged at read time instead of fanned out on write.
FEED_FANOUT_MAX_FOLLOWERS=5000
# Concurrency per BullMQ worker (video transcoding always runs one job at a time per process).
WORKER_CONCURRENCY=5

# Transactional email (account deletion confirmation, report receipts). Unset = email jobs are skipped.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# EMAIL_FROM=MyBuddy <no-reply@mybuddy.app>

# Queue dashboard at /admin/queues (basic auth, user "admin"). Keep it on the internal network.
# ENABLE_QUEUE_DASHBOARD=true
# QUEUE_DASHBOARD_PASSWORD=
