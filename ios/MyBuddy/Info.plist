<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSContactsUsageDescription</key>
	<string>MyBuddy uses your contacts to find friends who are already on MyBuddy. Contacts are matched by phone number and are not stored on our servers.</string>
	<key>NSCameraUsageDescription</key>
	<string>MyBuddy uses the camera so you can take photos and videos to share in chats.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MyBuddy accesses your photos so you can choose pictures to send and set your profile photo.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>MyBuddy uses the microphone to record sound when you capture video.</string>
	<key>MBTermsURL</key>
	<string></string>
	<key>MBPrivacyPolicyURL</key>
	<string></string>
	<key>MBSupportURL</key>
	<string></string>
	<key>MBEnvironment</key>
	<string>$(MB_ENVIRONMENT)</string>
	<key>MBAPIBaseURL</key>
	<string>$(MB_API_BASE_URL)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>chidumennamdi.MyBuddy</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mybuddy</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
